<resources>
    <style name="WebStageTheme.Dark" parent="AppTheme">
        <item name="android:windowBackground">@color/web_stage_bar_dark</item>
        <item name="android:statusBarColor">@color/web_stage_bar_dark</item>
        <item name="android:navigationBarColor">@color/web_stage_bar_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="WebStageTheme.Light" parent="AppTheme">
        <item name="android:windowBackground">@color/web_stage_bar_light</item>
        <item name="android:statusBarColor">@color/web_stage_bar_light</item>
        <item name="android:navigationBarColor">@color/web_stage_bar_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
